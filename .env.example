NODE_ENV=development
PORT=3001

# Replace placeholders locally; never commit real credentials.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5433/kirana_identity?schema=public

# npm run db:test:setup creates a separate ignored .env.test, generates its
# password, and provisions/migrates a dedicated local PostgreSQL container.
# Never copy development or production credentials into .env.test.
# DATABASE_URL_TEST must use kirana_test at 127.0.0.1:5434/kirana_identity_test.
# Production: set NODE_ENV, DATABASE_URL and PORT in the hosting environment.
# Production application settings come only from process variables.
# JWT/email settings are added when their
# features are implemented in Milestones 2 and 3.
