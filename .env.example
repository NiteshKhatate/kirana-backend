NODE_ENV=development
PORT=3001

# Replace placeholders locally; never commit real credentials.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5433/kirana_identity?schema=public

# npm run db:test:setup creates a separate ignored .env.test, generates its
# password, and provisions/migrates a dedicated local PostgreSQL container.
# Never copy development or production credentials into .env.test.
# DATABASE_URL_TEST must use kirana_test at 127.0.0.1:5434/kirana_identity_test.
# Production: set NODE_ENV, DATABASE_URL and PORT in the hosting environment.
# Production application settings come only from process variables.
# /auth/me verifies short-lived RS256 access tokens.
JWT_ISSUER=kirana-identity
JWT_AUDIENCE=kirana-api
JWT_ACCESS_TTL_SECONDS=900
# Development: npm run auth:keys creates ignored .keys/jwt-public.pem and
# jwt-private.pem without printing or replacing existing keys. Restart after setup.
# Production requires JWT_PUBLIC_KEY containing an RSA public PEM (>=2048 bits).
# JWT_PUBLIC_KEY=YOUR_RSA_PUBLIC_PEM_WITH_ESCAPED_NEWLINES
# Token issuance and private signing-key configuration follow in Milestone 3.

# Development email is written only to ignored .local-mail/*.json files.
MAIL_TRANSPORT=development
EMAIL_FROM=no-reply@kirana.invalid
VERIFY_EMAIL_URL=http://localhost:3000/verify-email
EMAIL_VERIFICATION_TTL_SECONDS=86400
VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Production requires MAIL_TRANSPORT=smtp, a real EMAIL_FROM and an HTTPS
# VERIFY_EMAIL_URL without query parameters, credentials or fragments.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=YOUR_SMTP_USER
# SMTP_PASSWORD=YOUR_SMTP_PASSWORD
# SMTP_SECURE=false requires STARTTLS; true uses TLS from connection start.
